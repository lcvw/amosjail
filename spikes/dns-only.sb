(version 1)
(deny default)
(allow file-read*)
(allow file-write* (literal "/dev/null"))
(allow process-fork)
(allow process-exec)
(allow sysctl-read)
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
