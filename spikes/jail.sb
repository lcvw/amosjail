(version 1)
(deny default)
(define jail (param "JAIL"))
(define (j p) (string-append jail p))
; system binds, read-only (mosbind enforces ro too)
(allow file-read* (literal jail) (literal (j "/private")) (literal (j "/tmp")) (literal (j "/etc"))
  (subpath (j "/usr")) (subpath (j "/bin")) (subpath (j "/sbin")) (subpath (j "/System"))
  (subpath (j "/Library")) (subpath (j "/private/etc")))
(allow process-exec (subpath (j "/usr")) (subpath (j "/bin")) (subpath (j "/sbin")) (subpath (j "/work")))
; project bind, read-write, minus hooks
(allow file-read* file-write* (subpath (j "/work")) (subpath (j "/private/tmp")))
(deny file-write* (subpath (j "/work/.git/hooks")))
; devices
(allow file-read* file-write-data (literal (j "/dev/null")) (literal (j "/dev/zero")) (regex #"/dev/ttys[0-9]+$") (literal (j "/dev/tty")))
(allow file-read* (literal (j "/dev/urandom")) (literal (j "/dev/random")) (literal (j "/dev")))
(allow file-ioctl (literal (j "/dev/tty")) (regex #"/dev/ttys[0-9]+$"))
(deny file-ioctl (ioctl-command #x80017472))
(allow process-fork)
(allow sysctl-read)
(deny process-info*)
(deny sysctl-read (sysctl-name-prefix "kern.proc"))
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow mach-lookup (global-name "com.apple.system.logger") (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow network-outbound (remote tcp "*:*"))
(deny network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder") (path-literal (j "/private/var/run/mDNSResponder"))))
(allow file-read* (literal (j "/var")) (literal (j "/private/var")) (literal (j "/private/var/run")) (literal (j "/private/var/run/mDNSResponder")))
