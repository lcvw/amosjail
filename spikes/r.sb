(version 1)
(deny default)
(allow file-read* (with report) (literal "/private/etc/hosts"))
(allow file-read*)
(allow file-write* (literal "/dev/null"))
(allow process-fork)
(allow process-exec)
(allow sysctl-read)
(allow mach-lookup (with report))
(deny file-read-data (literal "/private/etc/services"))
