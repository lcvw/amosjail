(version 1)
(deny default)
(allow file-read*)
(allow file-write* (literal "/dev/null") (regex #"^/dev/ttys"))
(allow process-fork)
(allow process-exec)
(allow sysctl-read)
(deny process-info*)
(deny sysctl-read (sysctl-name-prefix "kern.proc"))
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow mach-lookup (global-name "com.apple.system.logger") (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow file-read-metadata (literal (string-append "/private/tmp/" (param "JAIL_ID"))))
